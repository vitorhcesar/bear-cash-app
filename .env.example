# Base URL da bear-cash-api.
# Em Expo (Android/iOS), se usar localhost o app troca automaticamente
# pelo IP do Metro (ex.: 192.168.x.x) ou 10.0.2.2 no emulador Android.
EXPO_PUBLIC_API_URL=http://localhost:3333

# Ferramentas de debug no app (ID da Polp, JSON da transação).
# true/false sobrescreve expo.extra.beta do app.json.
# EXPO_PUBLIC_BETA=true
