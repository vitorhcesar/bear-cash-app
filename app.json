{
  "expo": {
    "name": "BearCash",
    "slug": "bear-cash",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/bear-cash-app-icon.png",
    "scheme": "bear-cash",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0b0a",
    "ios": {
      "bundleIdentifier": "com.bearcash.app",
      "icon": "./assets/images/bear-cash-app-icon.png",
      "backgroundColor": "#0a0b0a",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "O BearCash precisa acessar suas fotos para definir a foto de perfil."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0b0a",
        "foregroundImage": "./assets/images/bear-cash-logo.png"
      },
      "backgroundColor": "#0a0b0a",
      "predictiveBackGestureEnabled": false,
      "package": "com.bearcash.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/bear-cash-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0b0a",
          "image": "./assets/images/bear-cash-logo.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O BearCash precisa acessar suas fotos para definir a foto de perfil."
        }
      ],
      "expo-image",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O BearCash usa o Face ID para desbloquear o app e confirmar ações sensíveis."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/bear-cash-logo.png",
          "color": "#0a0b0a",
          "defaultChannel": "default"
        }
      ],
      "./plugins/with-maven-central-workaround"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e9bd49c-c462-4202-89d4-32b53d9a8ed7"
      }
    },
    "owner": "vitorhcesar"
  }
}
