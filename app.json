{
  "expo": {
    "name": "Otto",
    "slug": "otto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/otto-app-icon.png",
    "scheme": "otto",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0b0a",
    "ios": {
      "bundleIdentifier": "com.fansyfans.otto",
      "icon": "./assets/images/otto-app-icon.png",
      "backgroundColor": "#0a0b0a",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0b0a",
        "foregroundImage": "./assets/images/otto-logo.png"
      },
      "backgroundColor": "#0a0b0a",
      "predictiveBackGestureEnabled": false,
      "package": "com.fansyfans.otto"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/otto-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0b0a",
          "image": "./assets/images/otto-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Otto usa o Face ID para desbloquear o app e confirmar ações sensíveis."
        }
      ],
      "./plugins/with-maven-central-workaround"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72d334d0-1eaf-441e-a5ca-d197a7540ba0"
      }
    }
  }
}
